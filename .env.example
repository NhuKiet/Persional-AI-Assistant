# ── LLM (Ollama) ────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_NUM_GPU=80          # 99 = full CUDA offload, 0 = CPU only
LLM_TIMEOUT=300

# ── LLM providers (multi-model) ─────────────────────────────────────
DEFAULT_PROVIDER=ollama          # ollama | anthropic | openai
DEFAULT_MODEL=                   # rỗng = model mặc định của provider
ANTHROPIC_API_KEY=               # Optional — bật Claude
OPENAI_API_KEY=                  # Bật OpenAI / endpoint OpenAI-compatible — Required cho Research knowledge store (embeddings)
OPENAI_BASE_URL=                 # Optional — vd http://localhost:1234/v1 (LM Studio / vLLM)

# ── Embeddings + knowledge store ────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto | cuda | cpu. GPU 4GB có bật HMER thì đặt cpu: reranker (~1.9GB) và
# SwinCoMER (~1.2GB) cùng lên GPU thì Windows tràn VRAM sang RAM, HMER treo.
RERANKER_DEVICE=auto
KNOWLEDGE_THRESHOLD=0.65
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_OVERLAP=50
KNOWLEDGE_TOP_K=40

# ── Weaviate Cloud (knowledge store) ────────────────────────────────
WEAVIATE_URL=              # https://xxx.weaviate.cloud
WEAVIATE_API_KEY=          # API key của cluster
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Supabase (session/message storage) ──────────────────────────────
SUPABASE_DB_URL=            # postgresql://postgres:postgres@127.0.0.1:54322/postgres (local) hoặc connection string Supabase host
SUPABASE_DB_URL_DOCKER=     # chỉ cần khi chạy `docker compose up` — cùng URL trên nhưng đổi host sang host.docker.internal (container không resolve được 127.0.0.1 về máy host)

# ── Rerank (knowledge retrieve) ─────────────────────────────────────
COHERE_API_KEY=            # Optional — bật Cohere Rerank; thiếu thì tự dùng BGE local hoặc base score
RERANK_ENABLED=true
RERANK_GATE_THRESHOLD=0.5  # điểm rerank tối thiểu để chấp nhận cache hit
RERANK_CANDIDATES=30       # số section tối đa đưa vào rerank

# ── Search APIs ─────────────────────────────────────────────────────
TAVILY_API_KEY=            # Required for web search — https://app.tavily.com
S2_API_KEY=                # Optional — raises Semantic Scholar rate limit
# DuckDuckGo (ddgs) và Stack Overflow (Stack Exchange API) không cần key.

# ── Coding agent ────────────────────────────────────────────────────
CODE_TIMEOUT=30
MAX_DEBUG_ITER=4
MAX_OUTPUT_LEN=8000
ENABLE_TESTS=false
ENABLE_REVIEW=false
ENABLE_AUTO_INSTALL=false  # BẢO MẬT: bật = code sinh tự pip install vào env máy chủ. Chỉ bật khi EXECUTOR_MODE=docker

# ── Executor sandbox ────────────────────────────────────────────────
EXECUTOR_MODE=docker       # Docker-only — bắt buộc, giá trị khác bị Settings từ chối lúc khởi động
EXECUTOR_IMAGE=king-executor:latest  # build: docker build -f Dockerfile.executor -t king-executor:latest .
EXECUTOR_MEMORY=512m
EXECUTOR_CPUS=1.0
EXECUTOR_PIDS=128

# ── Giới hạn tải / chi phí ──────────────────────────────────────────
MAX_MESSAGE_CHARS=24000    # chặn message quá dài (blow-up token/chi phí)
MAX_UPLOAD_MB=20           # giới hạn kích thước file upload cho Coding

# ── Chat ────────────────────────────────────────────────────────────
MAX_HISTORY=20

# ── PDF ─────────────────────────────────────────────────────────────
PDF_MAX_CONTEXT=6000
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=100

# ── Assistant bubble (bridge sang ai-agent, dự án Telegram bot riêng) ─
# Chạy scripts\run_bridge.bat bên ai-agent, dùng CÙNG giá trị BRIDGE_TOKEN.
BRIDGE_URL=http://127.0.0.1:8766
BRIDGE_TOKEN=

# ── HMER (nhận dạng công thức toán viết tay, SwinCoMER) ─────────────
# Checkpoint không nằm trong repo. Để trống thì /api/hmer/recognize trả 503
# và capability "hmer" báo disabled — app vẫn chạy bình thường.
# Cài package model theo README, mục HMER — KHÔNG dùng `pip install -e` thường
# (requirements.txt của repo capstone ghim matplotlib 3.5.1 và tool dev).
# Chỉ checkpoint ComerSwin-...-val_ExpRate=0.4713.ckpt khớp dictionary.txt.
HMER_CHECKPOINT=
HMER_UPLOAD_DIR=data/hmer
HMER_DEVICE=auto           # auto | cuda | cpu
HMER_MAX_IMAGE_MB=10
