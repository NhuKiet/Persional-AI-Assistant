# Ảnh sandbox để chạy code do LLM sinh (EXECUTOR_MODE=docker, bắt buộc).
# Build: docker build -f Dockerfile.executor -t king-executor:latest .
#
# Container chạy với --network none nên KHÔNG cài package lúc runtime được —
# phải nạp sẵn bộ thư viện hay dùng ở đây. Thêm gói mới thì bổ sung dòng dưới
# rồi build lại image.
FROM python:3.11-slim

# Bộ thư viện phổ biến cho tác vụ data/coding của agent. Cố tình gọn để ảnh nhẹ.
RUN pip install --no-cache-dir \
        numpy \
        pandas \
        matplotlib \
        scipy \
        scikit-learn \
        openpyxl \
        tabulate

# UID/GID cố định, không phải root. `docker run` phía executor đã tự set
# --cap-drop ALL + --security-opt no-new-privileges:true + --read-only +
# --network none (xem backend/app/features/coding/execution.py); chạy dưới
# user thường loại bỏ luôn khả năng leo quyền root bên trong container nếu
# một trong các giới hạn trên bị bypass. Đây là default AN TOÀN khi không có
# override nào khác — nhưng trên host POSIX, executor tự override bằng
# `--user <host-uid>:<host-gid>` (xem _host_user_docker_args() trong
# execution.py) để UID bên trong container khớp với chủ sở hữu thư mục
# sandbox trên host, tránh phải nới quyền ghi thư mục đó. Trên Windows
# không có override tương ứng (không có UID kiểu POSIX) nên UID 10001 ở
# đây vẫn là UID thực sự chạy, và CodeExecutor.run() dùng chmod(0o777) làm
# phương án dự phòng chỉ cho nhánh Windows.
RUN groupadd --gid 10001 executor \
        && useradd --uid 10001 --gid executor --no-create-home --shell /usr/sbin/nologin executor

WORKDIR /work

# Không có ENTRYPOINT: executor gọi `docker run ... python /work/<script>.py`.
# USER phải đứng trước CMD/ENTRYPOINT — ở đây không có CMD nên đây là dòng
# cuối, áp dụng cho lệnh `python ...` mà `docker run` truyền vào.
USER 10001:10001
